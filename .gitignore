.DS_Store
# Original asset zips (provenance only, not loaded; 123 MB exceeds GitHub's file limit)
assets/characters/_src/
# Google Street View screenshots: private reference only, never publish
reference/
# Leaderboard server: local secrets and build output (never commit these)
server/.dev.vars
server/.env
server/.env.*
server/node_modules/
server/.wrangler/

# full-quality music originals (the game ships compressed copies in assets/music/)
music-originals/

# unprocessed originals of the optimised assets (textures, logos, character textures, trimmed GLBs); not loaded by the game
assets-originals/
